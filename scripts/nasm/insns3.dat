;; utasm: the lines of NASM 3.01's x86/insns.dat for the instructions its
;; 2.16.03 one (insns.dat, here) has not - AVX10.2, AVX-VNNI-INT16, AMX-FP8,
;; AMX-AVX512, AMX-MOVRS, AMX-COMPLEX, AMX-FP16, MOVRS - as they are there,
;; but "vex+" written as "vex" (the EVEX form for r16-r31 is utasm's own
;; promotion) and NASM 3's templates ($bwdq, $dq) written out. Not taken:
;; AMX-TRANSPOSE and AMX-TF32 (GNU as 2.47 has dropped them). VMOVRS[BWDQ]
;; are not in NASM 3.01: written from Intel's manual (GNU as 2.47 agrees).
;; NASM's VCVTPH2BF8 / BF8S / HF8 / HF8S give the 256- and 512-bit forms a
;; ymm / zmm destination: they narrow (xmm, ymm), as Intel and objdump have.
;; Read by scripts/gen_x86_enc.py after insns.dat.
;;
VBCSTNEBF162PS	xmmreg,mem16				[rm:	vex.128.f3.0f38.w0 b1 /r]	AVXNECONVERT,SW
VBCSTNEBF162PS	ymmreg,mem16				[rm:	vex.256.f3.0f38.w0 b1 /r]	AVXNECONVERT,SW
