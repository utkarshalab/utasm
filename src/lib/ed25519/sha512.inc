%ifndef CRYPTO_UHASH_SHA512_INC
%define CRYPTO_UHASH_SHA512_INC

SHA512_BLOCK_SIZE   equ 128         ; 128-byte block size
SHA512_DIGEST_SIZE  equ 64          ; 64-byte (512-bit) digest

struc sha512_ctx_t
    .state      resq 8              ; +00: 8 x 64-bit state words (H0..H7)
    .count      resq 2              ; +64: 128-bit bit count processed
    .buf        resb 128            ; +80: 128-byte block buffer
    .buf_len    resd 1              ; +208: Unprocessed bytes in buf
endstruc

; sha512_ctx_t_size is auto-generated by NASM's struc directive above.
; Redefining it here made every file that includes this header fail to assemble.

%endif ; CRYPTO_UHASH_SHA512_INC
