%ifndef CRYPTO_USIGN_ED25519_INC
%define CRYPTO_USIGN_ED25519_INC

ED25519_PUBKEY_SIZE equ 32          ; 32-byte (256-bit) public key
ED25519_SIG_SIZE    equ 64          ; 64-byte signature (R point + S scalar)

; Algorithm IDs
USIGN_ALGO_UNKNOWN   equ 0
USIGN_ALGO_ED25519   equ 1
USIGN_ALGO_ECDSA_P256 equ 2
USIGN_ALGO_RSA_2048  equ 3
USIGN_ALGO_DILITHIUM equ 4

; Envelope Format IDs
USIGN_FMT_RAW        equ 1          ; Raw binary
USIGN_FMT_PEM        equ 2          ; ASCII armored Base64 PEM
USIGN_FMT_PKCS7      equ 3          ; PKCS#7 / CMS Secure Boot envelope
USIGN_FMT_UPK_SIG    equ 4          ; Utkarsha UPK package signature envelope

; Status Result Codes
USIGN_STATUS_VALID   equ 1          ; Signature 100% verified valid
USIGN_STATUS_INVALID equ 0          ; Verification failed / bad signature
USIGN_STATUS_BAD_FMT equ -1         ; Malformed signature envelope format

; -----------------------------------------------------------------------------
; Master Signature Verification Metadata Container (64 bytes)
; -----------------------------------------------------------------------------
struc usign_meta_t
    .algo_id        resd 1          ; +00: Algorithm ID (USIGN_ALGO_ED25519...)
    .format_id      resd 1          ; +04: Envelope Format ID (USIGN_FMT_RAW...)
    .pubkey_ptr     resq 1          ; +08: Pointer to public key buffer
    .pubkey_len     resd 1          ; +16: Public key size in bytes
    .sig_ptr        resq 1          ; +20: Pointer to signature buffer
    .sig_len        resd 1          ; +28: Signature size in bytes
    .status         resd 1          ; +32: Output status result code
    .reserved       resq 3          ; +36..+60: Reserved padding
endstruc

; usign_meta_t_size is auto-generated by the struc directive above. Redefining
; it made every module that includes this header fail to assemble.

; -----------------------------------------------------------------------------
; Ed25519 Signature Struct (64 bytes)
; -----------------------------------------------------------------------------
struc ed25519_sig_t
    .r_point        resb 32         ; +00: 32-byte R point
    .s_scalar       resb 32         ; +32: 32-byte S scalar
endstruc


%endif ; CRYPTO_USIGN_ED25519_INC
